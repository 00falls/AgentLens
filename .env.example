# Copy this file to .env. Never commit provider keys.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=openai/deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
LITELLM_MASTER_KEY=sk-agentlens-local-dev
AGENTLENS_MODEL_BASE_URL=http://127.0.0.1:4000/v1
AGENTLENS_MODEL=agentlens-agent
AGENTLENS_JUDGE_MODEL=agentlens-agent
AGENTLENS_MODEL_API_KEY=sk-agentlens-local-dev
AGENTLENS_DATABASE_URL=postgresql+psycopg://agentlens:agentlens-local@127.0.0.1:5432/agentlens
AGENTLENS_REQUEST_TIMEOUT=60
AGENTLENS_MAX_MODEL_CALLS=6
AGENTLENS_MAX_OUTPUT_TOKENS=1200
AGENTLENS_MCP_URL=http://127.0.0.1:8010/mcp

# Optional override; default is the project-local pinned BGE snapshot.
# AGENTLENS_EMBEDDING_PATH=C:/path/to/bge-small-zh-v1.5

AGENTLENS_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Local development ingest key, separate from model credentials.
AGENTLENS_OTLP_INGEST_KEY=agentlens-collector-local-dev

# Generate project-bound API identities with scripts/init_identities.py (never commit the file).
# AGENTLENS_IDENTITY_PATH=C:/protected/path/identities.json
# Requires a reachable OpenShell gateway; never executes generated code on the host.
AGENTLENS_OPENSHELL_BINARY=openshell
AGENTLENS_SANDBOX_IMAGE=agentlens-analysis:week8

